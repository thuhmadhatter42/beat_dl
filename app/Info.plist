<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Beat Key.app's Info.plist (public name Beat Key; executable, bundle ID and code stay Orion). build.sh writes CFBundleShortVersionString / CFBundleVersion from
     VERSION and the copyright year into the bundle's copy; this file keeps placeholders. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Beat Key</string>
    <key>CFBundleDisplayName</key><string>Beat Key</string>
    <key>CFBundleIdentifier</key><string>com.jshriver.orion</string>
    <key>CFBundleExecutable</key><string>Orion</string>
    <key>CFBundleIconFile</key><string>Orion</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleShortVersionString</key><string>0.0.0</string>
    <key>CFBundleVersion</key><string>0.0.0</string>
    <key>NSHumanReadableCopyright</key><string>© J Shriver</string>
    <key>LSMinimumSystemVersion</key><string>12.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.music</string>
    <key>NSDownloadsFolderUsageDescription</key><string>Beat Key saves your MP3s to the Downloads folder.</string>
    <key>NSDesktopFolderUsageDescription</key><string>Beat Key reads the audio files you choose to find their BPM and key.</string>
    <key>NSDocumentsFolderUsageDescription</key><string>Beat Key reads the audio files you choose to find their BPM and key.</string>
    <!-- Listen (plan §3). Inputs: AVAudioEngine, needs the audio-input entitlement too
         (entitlements-app.plist). System audio is ScreenCaptureKit: macOS asks for Screen (& System
         Audio) Recording with its own fixed text, no Info.plist key exists for it.
         NSAudioCaptureUsageDescription is the macOS 14.2+ system-audio string (Core Audio taps),
         here so a later move to taps or a future SCK prompt has the sentence ready. -->
    <key>NSMicrophoneUsageDescription</key><string>Beat Key listens to the input you choose to find the key and BPM of what is playing. Nothing is recorded or saved.</string>
    <!-- Live listening's new-song detection (Live/SongBoundary.swift) reads, never controls, Spotify's
         current track and the titles of YouTube tabs in Brave / Chrome / Safari. Needs the
         apple-events entitlement too (entitlements-app.plist). -->
    <key>NSAppleEventsUsageDescription</key><string>While Beat Key is listening, it reads the title of the song playing in Spotify or a YouTube tab, so each new song gets a fresh reading under its own name. It never controls the app.</string>
    <key>NSAudioCaptureUsageDescription</key><string>Beat Key listens to what your Mac is playing to find its key and BPM. Nothing is recorded or saved.</string>
    <!-- Finder › Services › Analyze with Beat Key (ServiceProvider.analyzeWithBeatKey in Intake.swift).
         NSPortName is the name OrionApp registers the provider under. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Analyze with Beat Key</string></dict>
            <key>NSMessage</key><string>analyzeWithBeatKey</string>
            <key>NSPortName</key><string>Beat Key</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.audio</string>
                <string>public.movie</string>
                <string>public.midi-audio</string>
            </array>
        </dict>
    </array>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
    <!-- Sparkle updates (app/RELEASING.md). The feed is the appcast.xml attached to the newest
         GitHub release; the private half of SUPublicEDKey is in the login Keychain (account
         beat-key) and ~/.config/beat-key/sparkle_ed25519_private, never in the repo. -->
    <key>SUFeedURL</key><string>https://github.com/thuhmadhatter42/beat_dl/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key><string>ss+JogewI0vocoCCYnKwn4VuDrcU1APzhm4A4RDF9Ik=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUScheduledCheckInterval</key><integer>86400</integer>
</dict>
</plist>
